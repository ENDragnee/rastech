// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String  @id @default(cuid())
  name     String?
  userName String  @unique
  password String
  isActive Boolean @default(true)

  sessions        Session[]
  logs            Log[]
  transactions    Transaction[]
  creditsCreated  Credit[]      @relation("CreditCreatedBy")
  creditsApproved Credit[]      @relation("CreditApprovedBy")

  roles       Role[]
  permissions Permission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  sessionToken String   @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sessions")
}

model Role {
  id        String @id @default(cuid())
  name      String
  guardName String

  users       User[]
  permissions Permission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model Permission {
  id        String @id @default(cuid())
  name      String
  guardName String

  users User[]
  roles Role[]

  moduleId String
  modules  Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("permissions")
}

model Module {
  id       String  @id @default(cuid())
  name     String
  slug     String
  isActive Boolean @default(false)

  permissions Permission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("modules")
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  products    Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

model Product {
  id          String  @id @default(cuid())
  name        String
  sku         String? @unique
  description String?

  withVat      Boolean? @default(true)
  warrantyDays Int?     @default(0)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  stocks Stock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

enum ProductCategory {
  COMPUTER_ACCESSORIES
  DESKTOP_AND_PRINTER
  NETWORK_AND_SECURITY_CAMERAS
  LAPTOP_COMPUTER
  HARDDRIVE_AND_RAM
  TONERS
}

model Stock {
  id           String  @id @default(cuid())
  serialNumber String? @unique
  batchNumber  String?
  quantity     Int

  costPrice    Float
  sellingPrice Float
  withVat      Boolean @default(false)

  productId String
  products  Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  history   Transaction[]
  credit    Credit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("stocks")
}

model Transaction {
  id            String          @id @default(cuid())
  invoiceNumber String?         @unique
  type          TransactionType
  quantity      Int
  price         Float

  paymentMethod PaymentMethod?
  bankId        String?
  bank          Bank?          @relation(fields: [bankId], references: [id], onDelete: SetNull)
  customerName  String?
  customerPhone String?

  warrantyEndsAt DateTime?

  stockId String
  stocks  Stock  @relation(fields: [stockId], references: [id], onDelete: Restrict)

  userId String?
  users  User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  credit Credit?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("transactions")
}

enum TransactionType {
  SOLD
  PURCHASED
  RETURNED
  DEFECTIVE
  ADJUSTMENT_LOSS
  VOIDED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  ADJUSTMENT_LOSS
  CREDIT
}

model Bank {
  id            String        @id @default(cuid())
  name          String
  accountNumber BigInt?
  transactions  Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@map("banks")
}

model Credit {
  id            String  @id @default(cuid())
  customerName  String
  customerPhone String?
  customerIdDoc String?

  quantity    Int
  totalAmount Float
  dueDate     DateTime?
  status      CreditStatus @default(PENDING)

  stockId String
  stock   Stock  @relation(fields: [stockId], references: [id], onDelete: Restrict)

  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  createdById String?
  createdBy   User?   @relation("CreditCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  approvedById String?
  approvedBy   User?   @relation("CreditApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerName, customerPhone])
  @@map("credits")
}

enum CreditStatus {
  PENDING
  RETURNED
  PAID
  DEFAULTED
}

model Log {
  id       String      @id @default(cuid())
  type     String
  severity LogSeverity @default(INFO)

  message String @db.Text
  details Json?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  ipAddress String?

  targetId   String?
  targetName String?

  createdAt DateTime @default(now())

  @@index([type])
  @@index([severity])
  @@index([userId])
  @@index([ipAddress])
  @@index([targetId])
  @@index([targetName])
  @@map("logs")
}

enum LogSeverity {
  INFO
  WARNING
  ERROR
  FATAL
}
